<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="process_order_view_form" model="ir.ui.view">
        <field name="name">process.order.view.form</field>
        <field name="model">process.order</field>
        <field name="arch" type="xml">
            <form string="Process_order" create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. PO-0001" readonly="1" force_save="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="display_address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids">
                                <list editable="bottom">
                                    <field name="partner_id" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="order_ids" widget="many2many_tags" column_invisible="1"/>
                                    <field name="sale_order_line_ids" widget="many2many_tags" column_invisible="1"/>
                                    <field name="order_quantity" sum="Total Order" string="Order Qty"/>
                                    <field name="delivered_quantity" sum="Total Deliver" string="Deliver Qty"/>
                                    <field name="pending_quantity" readonly="1" sum="Total Pending" string="Pending Qty"/>
                                    <button name="deliver_quantity_action" type="object" string="Dispatch" class="btn-primary" invisible="not pending_quantity"/>
                                    <button name="open_dispatch_history" type="object" string="History" class="btn-primary" invisible="not delivered_quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="process_order_view_list" model="ir.ui.view">
        <field name="name">process.order.view.list</field>
        <field name="model">process.order</field>
        <field name="arch" type="xml">
            <list string="Process_order" create="0" delete="0" edit="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="display_address"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_process_order_search" model="ir.ui.view">
        <field name="name">process.order.search</field>
        <field name="model">process.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_line_ids" string="Product" filter_domain="[('order_line_ids.product_id', 'ilike', self)]"/>
                <filter name="active_filter" string="Active" domain="[('active', '=', True)]"/>
                <group>
                    <filter name="group_partner"
                            string="Partner"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="process_order_action" model="ir.actions.act_window">
        <field name="name">Process order</field>
        <field name="res_model">process.order</field>
        <field name="view_mode">list,form,search</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first process order!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="process_order_menu"
              name="Dispatch"
              action="process_order_action"
              parent="jm_parformma_custom.menu_parffoma_root"
              sequence="16"/>
</odoo>
