<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="seq_sale_order_gt" model="ir.sequence">
            <field name="name">GT Sale Order Sequence</field>
            <field name="code">sale.order.gt</field>
            <field name="prefix">GT-</field>
            <field name="padding">5</field>
<!--            <field name="next_number_actual">678</field>-->
        </record>
        <record id="seq_sale_order_ap" model="ir.sequence">
            <field name="name">AP Sale Order Sequence</field>
            <field name="code">sale.order.ap</field>
            <field name="prefix">AP-</field>
            <field name="padding">5</field>
<!--            <field name="next_number_actual">750</field>-->
        </record>

        <record id="seq_process_order" model="ir.sequence">
            <field name="name">Process Order</field>
            <field name="code">process.order</field>
            <field name="prefix">PO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>
