<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dispatch_history_wizard" model="ir.ui.view">
        <field name="name">dispatch.history.wizard.form</field>
        <field name="model">dispatch.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Dispatch History">
                <group>
                    <field name="date_range_type"/>
                    <field name="start_date" invisible="date_range_type!='custom'"/>
                    <field name="end_date" invisible="date_range_type!='custom'"/>
                </group>

                <footer>
                    <button string="Generate"
                            type="object"
                            name="action_generate_pdf"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
