<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="process_order_wizard_form_view_inherit_custom" model="ir.ui.view">
        <field name="name">process.order.wizard.form.view.inherit.custom</field>
        <field name="model">process.order.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. PO-0001" readonly="1" force_save="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="max_quantity" readonly="1"/>
                            <field name="quantity"
                                   style="font-weight:bold;"
                                   decoration-danger="pending_qty&lt;0.0"
                                   decoration-success="pending_qty==0.0"
                                   decoration-muted="pending_qty&gt;0.0"/>
                            <field name="pending_qty"
                                   style="font-weight:bold;"
                                   decoration-danger="pending_qty&lt;0.0"
                                   decoration-success="pending_qty==0.0"
                                   decoration-muted="pending_qty&gt;0.0"
                                   readonly="1"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
