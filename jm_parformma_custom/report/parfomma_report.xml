                                <td style="width:75%; border:1px solid #000; padding:1px;" colspan="2">
                                    <b>ORDER NO :</b>
                                </td>
                                <td style="width:25%; border:1px solid #000; padding:1px;" colspan="2">
                                    <span t-esc="o.order_no" style="font-size:1rem;"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:1px solid #000; padding:1px; width:22%">
                                    <b>COMPANY NAME</b>
                                </td>
                                <td style="border:1px solid #000; padding:1px; width:51%;">
                                    <span t-field="o.company_name" style="font-size:1rem;"/>
                                </td>
                                <td style="border:1px solid #000; padding:1px; width:12%">
                                    <b>DATE :</b>
                                </td>
                                <td style="border:1px solid #000; padding:1px; width:15%">
                                    <span t-esc="o.date.strftime('%d-%m-%Y')" style="font-size:1rem;"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:1px solid #000; padding:1px;">
                                    <b>PRODUCT NAME</b>
